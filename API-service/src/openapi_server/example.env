# Core switch
# openai | scads
OPENAI_API_KEY=your_openai_api_key_here

# ScaDS.AI API key (if PROVIDER=scads)
SCADS_API_KEY=your_scads_api_key_here


# Redis service conf
REDIS_URL=redis://127.0.0.1:6379/0
CACHE_TTL_SECONDS=15

# LLM provider for habit judgment and context classification
PROVIDER=scads
CLASSIFY_HABIT_MODEL=openai/gpt-oss-120b
CLASSIFY_HABIT_CONTEXT_MODEL=openai/gpt-oss-120b
# PROVIDER=openai
# CLASSIFY_HABIT_MODEL=gpt-5.2
# CLASSIFY_HABIT_CONTEXT_MODEL=gpt-5.2
TEMPERATURE=0.0
MAX_TOKENS=1024

# Ontology mapping config
MILVUS_URI=http://localhost:19530
THRESHOLD_BCIO_MAP=0.4
TOP_N_BCIO_MAP=2
BCIO_DENSE_WEIGHT=0.8
# This controls whether to rebuild the Milvus index at startup; 1 indicates rebuilding, and 0 indicates not rebuilding.
BCIO_REBUILD_INDEX=0
BCIO_COLLECTION_NAME=bcio_concepts_hybrid


# kb
# Do not modify the 8 parameters below at all; it may easily cause errors.
KB_MILVUS_COLLECTION=kb_chunks_bgem3_test1
KB_PROVIDER=scads
KB_MODEL=openai/gpt-oss-120b
# KB_PROVIDER=openai
# KB_MODEL=gpt-5.2
# KB_EMBED_PROVIDER=openai
# KB_EMBED_MODEL=text-embedding-3-small
KB_EMBED_PROVIDER=bge-m3
KB_EMBED_MODEL=BAAI/bge-m3
KB_EMBED_DIM=1024
KB_EMBED_DEVICE=cpu
KB_EMBED_FP16=0
# You can modify the three parameters below.
KB_TOP_N=35
KB_SCORE_THRESHOLD=0.65
KB_CANDIDATES=200
# You can modify the six parameters below. The PDF will be reindexed.
KB_PDF_STRATEGY=fast
# KB_PDF_STRATEGY=hi_res
# KB_PDF_STRATEGY=ocr_only
# KB_PDF_STRATEGY=auto
KB_INFER_TABLE_STRUCTURE=1
KB_CHUNK_MAX_CHARACTERS=2500
KB_CHUNK_NEW_AFTER_N_CHARS=2000
KB_CHUNK_COMBINE_UNDER_N_CHARS=300
KB_EXTRACT_IMAGES=0


# HABIT_DB_SELECT
HABIT_DB_SELECT_LLM_PROVIDER=scads
HABIT_DB_SELECT_LLM_MODEL=openai/gpt-oss-120b
# HABIT_DB_SELECT_LLM_PROVIDER=openai
# HABIT_DB_SELECT_LLM_MODEL=gpt-5.2
HABIT_DB_SELECT_LLM_TEMPERATURE=0
HABIT_DB_SELECT_LLM_MAX_TOKENS=200000
# Maximum number of output records
HABIT_DB_SELECT_TOP_K=20
# Maximum number of inputs to LLM
HABIT_DB_SELECT_CANDIDATE_LIMIT=200


# profiles build
Profiles_LLM_PROVIDER=scads
Profiles_LLM_MODEL=openai/gpt-oss-120b
# Profiles_LLM_PROVIDER=openai
# Profiles_LLM_MODEL=gpt-5.2
Profiles_LLM_TEMPERATURE=0
Profiles_LLM_MAX_TOKENS=200000



# recommendation build
RECO_LLM_PROVIDER=scads
RECO_LLM_MODEL=openai/gpt-oss-120b
# RECO_LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct
# RECO_LLM_MODEL=deepseek-ai/DeepSeek-V3.2
# RECO_LLM_PROVIDER=openai
# RECO_LLM_MODEL=o3
# RECO_LLM_MODEL=gpt-5.2
# RECO_LLM_MODEL=gpt-5.2-pro
RECO_LLM_TEMPERATURE=0
RECO_LLM_MAX_TOKENS=128000
