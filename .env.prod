# Proxy
PROXY_PATH=proxy
PATH_SUFFIX=localhost
TRAEFIK_HOST_PORT80=80
TRAEFIK_HOST_PORT8080=8080

# App
APP_PATH=app
APP_BASE_PATH=/
APP_HOST_PORT=1000
NODE_ENV=production
SERVER_IP=141.76.16.16

# Fuseki API
FUSEKI_PATH=fuseki
FUSEKI_HOST_PORT=3030

# Translate API
TRANSLATE_HOST=translate
TRANSLATE_PORT=5000
LT_HOST=${TRANSLATE_HOST}
LT_PORT=${TRANSLATE_PORT}
LT_LOAD_ONLY=de,en,ja
LT_REQ_LIMIT=0
LT_DEBUG=
LT_DISABLE_WEB_UI=
#LT_UPDATE_MODELS=
#LT_METRICS=

# Database
ADMIN_PASSWORD=CHANGE_ME
HOST=localhost
DB_HOST=fuseki
DB_PORT=3030
DB_USER=admin
DB_PASSWORD=CHANGE_ME
DB_PATH=hhh

# Graph storage backend for habit donations: 'fuseki' or 'neo4j'
GRAPH_BACKEND=neo4j

# Neo4j (used when GRAPH_BACKEND=neo4j)
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME

# See: https://developers.google.com/recaptcha/docs/faq#can-i-use-recaptcha-globally
# IMPORTANT: Use REGULAR reCAPTCHA v2 keys (NOT Enterprise)
# Generate at: https://www.google.com/recaptcha/admin/create
# Choose "reCAPTCHA v2" -> "I'm not a robot Checkbox"
# Testing with Google's official test keys first
RECAPTCHA_SITEKEY=CHANGE_ME
RECAPTCHA_SECRETKEY=CHANGE_ME
RECAPTCHA_USE_RECAPTCHA_DOMAIN=false

# MongoDB Configuration for Testing
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=CHANGE_ME
MONGO_DB=test_surveyjs
MONGO_AUTH_SOURCE=admin
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=5000

# Mongo Express UI
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=CHANGE_ME

#Mail Setup for contact form (Using Mailjet API and Secret Key)
MAIL_USER=CHANGE_ME
MAIL_PASS=CHANGE_ME
MAIL_FROM=noreply@felixreinsch.de   # must match verified domain
MAIL_RECEIVER=felix.reinsch@tu-dresden.de


# Backup Configuration
BACKUP_RETENTION_DAYS=14
# Email address for backup failure notifications
ALERT_EMAIL=felix.reinsch@tu-dresden.de


# Configuration for deployment
DOMAIN=habit.wiwi.tu-dresden.de
ACME_EMAIL=felix.reinsch@tu-dresden.de
# ACME CA Server: Uses TU Dresden by default
# Only set this to switch to Let's Encrypt if TU Dresden ACME has issues:
# ACME_CA_SERVER=https://acme-v02.api.letsencrypt.org/directory
APP_BASE_PATH=/
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$bmBskF7N$$PfRuH.NJTH0zYa9gVAA2g1